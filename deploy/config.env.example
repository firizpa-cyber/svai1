# ─────────────────────────────────────────────────────────────
#  Данные вашего Ubuntu-сервера. Скопируйте этот файл в config.env
#  и впишите свои значения:   cp config.env.example config.env
# ─────────────────────────────────────────────────────────────

# IP-адрес или хостнейм сервера
SERVER_HOST=123.45.67.89

# Пользователь SSH (часто root, либо ubuntu / свой пользователь)
SERVER_USER=root

# Порт SSH (обычно 22)
SERVER_PORT=22

# Путь к приватному SSH-ключу (если входите по ключу).
# Оставьте пустым, если входите по паролю.
SSH_KEY=

# Куда положить проект на сервере
APP_DIR=/var/www/svai

# Имя приложения в PM2
APP_NAME=svai

# Внутренний порт, на котором слушает Nuxt (наружу торчит только Nginx)
APP_PORT=3000

# Домен сайта (для конфига Nginx). Можно указать несколько через пробел.
DOMAIN=zavod-vintovikh-svai.com www.zavod-vintovikh-svai.com

# Email для бесплатного SSL-сертификата Let's Encrypt (необязательно)
LETSENCRYPT_EMAIL=
