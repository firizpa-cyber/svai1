# Шаблон Nginx. Плейсхолдеры __DOMAIN__ и __APP_PORT__ подставляет server-setup.sh.
# default_server => сайт отвечает и по IP (пока домен не куплен), и по домену потом.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __DOMAIN__;

    # Лимит на размер тела (заявки/формы небольшие)
    client_max_body_size 10M;

    # Сжатие
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }

    # Долгое кеширование статики Nuxt (хэшированные файлы)
    location /_nuxt/ {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
